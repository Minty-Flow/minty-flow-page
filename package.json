		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.12.4",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"globals": "^17.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "~5.9.3",
		"vite": "^8.0.13"
	}
