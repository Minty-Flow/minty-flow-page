{
	"name": "minty-flow.github.io",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"types": "tsc -b",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"lint:fix-unsafe": "biome check --write --unsafe",
